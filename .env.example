# Server
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=INFO
CORS_ALLOW_ORIGINS=*
CORS_ALLOW_CREDENTIALS=false

# Cache
CACHE_DIR=/app/downloads
CACHE_RETENTION_SECONDS=86400
CACHE_CLEANUP_INTERVAL_SECONDS=900
CACHE_MAX_BYTES=2147483648
CACHE_CLEANUP_ON_START=false

# Download queue and reliability
DOWNLOAD_WORKER_COUNT=2
DOWNLOAD_QUEUE_MAXSIZE=200
DOWNLOAD_MAX_RETRIES=4
DOWNLOAD_BACKOFF_BASE_SECONDS=1.5
DOWNLOAD_BACKOFF_MAX_SECONDS=45
DOWNLOAD_JOB_TTL_SECONDS=3600
DOWNLOAD_PROVIDER_TIMEOUT_SECONDS=120
DOWNLOAD_UPSTREAM_CONCURRENCY=2
DOWNLOAD_SYNC_WAIT_SECONDS=25
DOWNLOAD_RATE_LIMIT_WINDOW_SECONDS=60
DOWNLOAD_RATE_LIMIT_MAX_REQUESTS=30

# Optional youtubei.js extractor service
YOUTUBEI_SERVICE_URL=http://localhost:3001
YOUTUBEI_SERVICE_TIMEOUT_SECONDS=20
YOUTUBEI_SERVICE_RETRIES=3

# Optional paid fallback provider
RAPIDAPI_KEY=

# Optional legacy deploy webhook. Keep disabled in container deployments.
ENABLE_DEPLOY_WEBHOOK=false
GITHUB_WEBHOOK_SECRET=

# Optional yt-dlp diagnostic override. Default is yt-dlp's public test video.
YT_DLP_DIAGNOSTIC_VIDEO_ID=BaW_jenozKc
