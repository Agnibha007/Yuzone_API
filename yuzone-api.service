[Unit]
Description=Yuzone API Service
After=network.target

[Service]
Type=simple
User=YOUR_USERNAME
WorkingDirectory=/home/YOUR_USERNAME/projects/Yuzone_API
Environment="PATH=/home/YOUR_USERNAME/projects/Yuzone_API/.venv/bin"
Environment="RAPIDAPI_KEY=YOUR_RAPIDAPI_KEY"
ExecStart=/home/YOUR_USERNAME/projects/Yuzone_API/.venv/bin/uvicorn api.main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
